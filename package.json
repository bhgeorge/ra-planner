{
  "name": "ra-planner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=26.0.0"
  },
  "description": "Phone-first, offline-capable, order-dependent checklist planner for RetroAchievements.",
  "scripts": {
    "dev": "vite --open",
    "build": "pnpm run checklists && vite build",
    "preview": "vite preview",
    "checklists": "tsx scripts/build-checklists.ts",
    "checklists:watch": "tsx scripts/build-checklists.ts --watch",
    "validate": "tsx scripts/validate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "js-yaml": "^4.1.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.3.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-window": "^7.4.1"
  }
}
